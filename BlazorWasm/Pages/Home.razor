@page "/"

@using BlazorWasm.Components
@using BlazorWasm
@inject TodoService TodoService

<PageTitle>Home</PageTitle>

<h1>Hello, Blazor BFF!</h1>

<AuthorizeView>
    <Authorized>
        <p>Welcome, @context.User.Identity.Name!</p>

        <TodoList />
    </Authorized>
    <NotAuthorized>
        <p>Please sign in to view your todo list.</p>
    </NotAuthorized>
</AuthorizeView>